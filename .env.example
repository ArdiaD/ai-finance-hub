# Optional API keys. Copy to .env and fill in the ones you use.

# Reliable Google Scholar access (https://serpapi.com). Leave blank to disable.
SERPAPI_KEY=

# LLM relevance scoring + LinkedIn post drafting (relevance.use_llm: true),
# and metadata extraction from PDFs that have no DOI/arXiv id.
ANTHROPIC_API_KEY=

# Polite contact for the Crossref API when resolving DOIs (optional but nice).
CROSSREF_MAILTO=

# Free Semantic Scholar API key (https://www.semanticscholar.org/product/api) —
# removes rate limits for `backfill-urls` (finding DOI/URL by title).
SEMANTIC_SCHOLAR_KEY=

